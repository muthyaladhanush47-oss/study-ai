# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- NVIDIA NIM (https://build.nvidia.com) - text AI (summaries, flashcards, quiz, mind map, chat) ---
NVIDIA_API_KEY=your-nvidia-nim-api-key

# Optional: override the default text model
# NOTE: deepseek-ai/deepseek-v4-flash was retired by NVIDIA on 2026-08-07.
# The supported successor is deepseek-ai/deepseek-v4-flash-0731.
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Optional: override the NVIDIA NIM endpoint (OpenAI-compatible)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Vision API (OCR) - needs a vision-capable model (a Google Gemini API key works) ---
# Rendered PDF pages are sent ONLY to this provider, never to the text model.
VISION_API_KEY=your-gemini-api-key

# Optional: vision model used for handwriting OCR (default: gemini-2.5-flash)
VISION_MODEL=gemini-2.5-flash

# Optional: custom vision endpoint (only when using a proxy / alternative provider)
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Monetization (optional) ---
# Your Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
# When unset, ad slots render a subtle "Advertisement" placeholder instead.
NEXT_PUBLIC_AD_CLIENT=

# Optional Google Analytics / Tag Manager measurement ID (loaded with ads)
# NEXT_PUBLIC_GOOGLE_TAG=G-XXXXXXXXXX

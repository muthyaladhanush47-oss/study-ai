# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- OpenRouter (https://openrouter.ai/settings/keys) ---
OPENROUTER_API_KEY=sk-or-your-key

# Optional: override the default AI model (default: google/gemini-2.5-flash)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: vision model used for handwriting OCR (default: google/gemini-2.5-flash)
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Monetization (optional) ---
# Your Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
# When unset, ad slots render a subtle "Advertisement" placeholder instead.
NEXT_PUBLIC_AD_CLIENT=

# Optional Google Analytics / Tag Manager measurement ID (loaded with ads)
# NEXT_PUBLIC_GOOGLE_TAG=G-XXXXXXXXXX
